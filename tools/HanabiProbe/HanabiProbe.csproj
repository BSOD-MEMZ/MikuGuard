<Project Sdk="Microsoft.NET.Sdk">

  <!-- 离线探针：把花火按固定时刻渲成 PNG，用来对着看效果。不参与插件打包。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HanabiProbe</AssemblyName>
    <RootNamespace>MikuGuard.Tools.HanabiProbe</RootNamespace>
    <CreateCipx>false</CreateCipx>
    <!-- 探针自己就是个 exe，别让插件的 GenerateAssemblyInfo=false 影响到它 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件项目的 Avalonia 是「编译期才有」的（PluginSdk 标了 ExcludeAssets=runtime），
         探针要自己带一份，版本跟 ClassIsland.Core 2.0.0.2 对齐。 -->
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <!-- Avalonia 11.3 依赖 STJ 9；探针进程里得有一份，插件本身在宿主里用宿主的 8.x -->
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
    <ProjectReference Include="..\..\MikuGuard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 花火素材跟着探针走：MikuGuardPaths 按「程序集所在目录」解析相对路径 -->
    <None Include="..\..\Assets\Hanabi\*.png" Link="Assets\Hanabi\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Hanabi\*.json" Link="Assets\Hanabi\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
