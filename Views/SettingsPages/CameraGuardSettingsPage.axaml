<ci:SettingsPageBase
    x:Class="MikuGuard.Views.SettingsPages.CameraGuardSettingsPage"
    x:Name="RootPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:vm="clr-namespace:MikuGuard.ViewModels"
    mc:Ignorable="d"
    d:DesignHeight="720" d:DesignWidth="860"
    d:DataContext="{d:DesignInstance vm:CameraGuardSettingsViewModel}">

    <!--
      版式照宿主自带设置页：settings-container + 一行一个 SettingsExpander
      （Header=设置名，Description=说明，Footer=控件）。
      不要再把 SettingsExpander 当成「分组卡片」把一堆 Grid 塞进 Content——
      那样渲染出来是嵌套卡片，和宿主其它页面完全不是一个样式。
    -->
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">

            <fa:InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                        Title="当前状态"
                        Message="{Binding StatusText}" />

            <TextBlock Text="监控" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,2" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEF4F;}"
                                 Header="启用摄像头守护"
                                 Description="关掉后不再检测摄像头使用情况，指示点与提醒都不会出现。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Monitor.Enabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF361;}"
                                 Header="检测间隔"
                                 Description="多久查一次系统摄像头访问记录。越短越及时，也越费 CPU。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider Width="150" Minimum="400" Maximum="6000" TickFrequency="100"
                                VerticalAlignment="Center"
                                Value="{Binding Settings.Monitor.PollingIntervalMs, Mode=TwoWay}" />
                        <TextBlock Width="56" VerticalAlignment="Center"
                                   Text="{Binding Settings.Monitor.PollingIntervalMs, StringFormat='{}{0} ms'}" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF18E;}"
                                 Header="监视目标"
                                 Description="只用来定位「预览」打开哪台设备；是否提醒由系统访问记录决定。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="200"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="刷新" Command="{Binding RefreshDevicesCommand}" />
                        <Button Content="预览" Command="{Binding PreviewCameraCommand}"
                                IsEnabled="{Binding HasConcreteDevice}"
                                ToolTip.Tip="打开预览窗口看这台摄像头的画面" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <TextBlock Text="程序过滤" FontSize="14" FontWeight="SemiBold" Margin="2,14,0,2" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE833;}"
                                 Header="匹配模式"
                                 Description="决定名单是「放行」还是「拦下」。">
                <fa:SettingsExpander.Footer>
                    <ComboBox Width="220" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="黑名单：名单内不提醒" />
                        <ComboBoxItem Content="白名单：只提醒名单内" />
                        <ComboBoxItem Content="全部提醒（不看名单）" />
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE8FD;}"
                                 Header="过滤名单"
                                 Description="可以填完整路径、exe 文件名或 UWP 包族名。"
                                 IsExpanded="True">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Settings.Filter.Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <fa:SettingsExpanderItem Content="{Binding DisplayName}"
                                                         Description="{Binding Match}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <Button Content="移除" VerticalAlignment="Center"
                                                Click="OnRemoveEntryClick" />
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="名单还是空的，添加一个程序试试。"
                               FontSize="12" Opacity="0.6" Margin="16,6,0,6"
                               IsVisible="{Binding HasNoFilterEntries}" />

                    <fa:SettingsExpanderItem Content="添加程序"
                                             Description="直接输入，或点「浏览」挑一个 exe。"
                                             Classes="has-radius">
                        <fa:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="220" Watermark="Zoom.exe"
                                         Text="{Binding NewEntryText, Mode=TwoWay}" />
                                <Button Content="添加" Command="{Binding AddEntryCommand}" />
                                <Button Content="浏览…" Click="OnBrowseExeClick" />
                            </StackPanel>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                </StackPanel>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE075;}"
                                 Header="正在使用摄像头的程序"
                                 Description="系统访问记录里当前处于「使用中」的程序，可以直接加入名单。"
                                 IsExpanded="True">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding DetectedApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <fa:SettingsExpanderItem Content="{Binding DisplayName}"
                                                         Description="{Binding Key}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <Button Content="加入名单" VerticalAlignment="Center"
                                                Click="OnAddDetectedClick" />
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="（当前没有程序在使用摄像头）"
                               FontSize="12" Opacity="0.6" Margin="16,6,0,6"
                               IsVisible="{Binding HasNoDetectedApps}" />
                </StackPanel>
            </fa:SettingsExpander>

            <TextBlock Text="提醒" FontSize="14" FontWeight="SemiBold" Margin="2,14,0,2" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE025;}"
                                 Header="弹出提醒"
                                 Description="摄像头被程序占用时提醒你。指示点不受这个开关影响。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Alert.Enabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE7F4;}"
                                 Header="提醒方式"
                                 Description="「自动」在 Windows 通知发不出去时改用插件内弹窗。">
                <fa:SettingsExpander.Footer>
                    <ComboBox Width="180" SelectedIndex="{Binding PresentationIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="自动（推荐）" />
                        <ComboBoxItem Content="仅 Windows 通知" />
                        <ComboBoxItem Content="仅插件内弹窗" />
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE9A8;}"
                                 Header="提醒冷却"
                                 Description="同一次使用期间，两次提醒之间至少隔这么久。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider Width="150" Minimum="0" Maximum="600" TickFrequency="10"
                                VerticalAlignment="Center"
                                Value="{Binding Settings.Alert.CooldownSeconds, Mode=TwoWay}" />
                        <TextBlock Width="56" VerticalAlignment="Center"
                                   Text="{Binding Settings.Alert.CooldownSeconds, StringFormat='{}{0} 秒'}" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE8D2;}"
                                 Header="标题文字"
                                 Description="提醒的标题，留空则使用「摄像头正在被使用」。">
                <fa:SettingsExpander.Footer>
                    <TextBox Width="220" Text="{Binding Settings.Alert.Title, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE9B2;}"
                                 Header="提醒配图"
                                 Description="Windows 通知里作为大图显示，插件内弹窗显示在顶部。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="200" Text="{Binding Settings.Alert.ImagePath, Mode=TwoWay}" />
                        <Button Content="浏览…" Click="OnBrowseImageClick" />
                        <Button Content="恢复默认" Click="OnResetImageClick" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE671;}"
                                 Header="「消除提醒」按钮"
                                 Description="在提醒里放一个「本次不再打扰」的按钮。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Alert.ShowDismissAction, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE7E8;}"
                                 Header="「关闭应用」按钮"
                                 Description="在提醒里放一个「直接关掉这个程序」的按钮。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Alert.ShowCloseAppAction, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE8FB;}"
                                 Header="操作结果回执"
                                 Description="点完提醒里的按钮后，再用一条通知告诉你结果。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Alert.ShowActionResult, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <TextBlock Text="诊断" FontSize="14" FontWeight="SemiBold" Margin="2,14,0,2" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE9E4;}"
                                 Header="通知注册与诊断"
                                 Description="未打包程序发 Windows 通知，需要在开始菜单留一个带 AUMID 的快捷方式。">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ToastStatus}" TextWrapping="Wrap" FontSize="12" Margin="16,10,16,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,16,4">
                        <Button Content="发送测试提醒" Command="{Binding TestToastCommand}" />
                        <Button Content="重新注册通知" Command="{Binding ReRegisterToastCommand}" />
                        <Button Content="注销通知身份" Command="{Binding UnregisterToastCommand}" />
                        <Button Content="重启监控" Command="{Binding RestartMonitorCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastActionText}" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Margin="16,0,16,10" />
                </StackPanel>
            </fa:SettingsExpander>

        </StackPanel>
    </ScrollViewer>

</ci:SettingsPageBase>
